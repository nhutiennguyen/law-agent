# Cấu hình biến môi trường cho AI Lawyer
# Có thể điền API key tại đây hoặc nhập trực tiếp trên giao diện Cài Đặt (Web UI)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini sử dụng (gemini-2.5-flash hoặc gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình máy chủ
HOST=127.0.0.1
PORT=8000
